# =============================================================================
# Архитектура: код бота → хостинг Amvera (или локально). БД → проект Supabase.
# Секреты в Amvera: панель приложения → «Переменные окружения», не коммитить .env
# =============================================================================

# --- Telegram (бот) ---
BOT_TOKEN=
BOT_USERNAME=
# Пост «Пост в канал» из /admin: id канала вида -1001234567890 (бот — админ канала)
TELEGRAM_CHANNEL_ID=

ADMIN_TELEGRAM_ID=
# Второй администратор (опционально): тот же доступ /admin и уведомления об оплате и напоминаниях
ADMIN_TELEGRAM_ID_2=

# URL этого приложения на Amvera (https без слэша в конце) — webhooks Telegram + ЮKassa
PUBLIC_BASE_URL=

# --- Supabase = только база PostgreSQL (создайте проект на supabase.com) ---
# Settings → API: Project URL и service_role key (только на сервере бота!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_USER=
YOOKASSA_WEBHOOK_PASSWORD=

# Локальная разработка: true. На Amvera в проде — false или не задавать (webhook Telegram)
TELEGRAM_USE_POLLING=true

# Порт HTTP (Amvera может подставить PORT сама)
PORT=3000

# График записи (Иркутск)
WORKING_HOURS_START=09:00
WORKING_HOURS_END=21:00
MAX_SLOTS_PER_DAY=5

# Автослоты в Supabase: каждый день до 5 окон (10,13,15,17,19 Иркутск). Бот дополняет таблицу slots раз в ~2 мин.
# AUTO_SLOTS_ENABLED=true   (false — слоты только вручную /addslot)
# AUTO_SLOTS_HORIZON_DAYS=7  — на сколько дней вперёд держать слоты в БД (как экран «7 дней» при записи; можно 14)
