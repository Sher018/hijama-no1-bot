# Telegram
BOT_TOKEN=
BOT_USERNAME=
ADMIN_TELEGRAM_ID=

# Публичный URL приложения (https, без слэша в конце) — webhooks Telegram + ЮKassa
PUBLIC_BASE_URL=

# Supabase (только service role на сервере, не в клиенте)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ЮKassa API (магазин)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Проверка входящих HTTP-уведомлений: те же учётные данные, что и для API (см. документацию ЮKassa)
# USER = shopId (как YOOKASSA_SHOP_ID), PASSWORD = секретный ключ (как YOOKASSA_SECRET_KEY)
YOOKASSA_WEBHOOK_USER=
YOOKASSA_WEBHOOK_PASSWORD=

# Опционально: long polling вместо webhook Telegram (для локальной разработки)
TELEGRAM_USE_POLLING=true

# Порт HTTP (Amvera часто задаёт PORT)
PORT=3000

# График записи для клиентов (локальное время Иркутска): только слоты с началом в этом окне
WORKING_HOURS_START=09:00
WORKING_HOURS_END=21:00
